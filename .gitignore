# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
env/
.venv/

# Node.js / Frontend
node_modules/
frontend/dist/
*.timestamp-*.mjs

# Built frontend served by the backend (generated from frontend/dist)
backend/static/

# Exported workspaces are user data, not source. The bundled sample lives in
# Test/fixtures/ instead, so it no longer shows up in the 项目文件 list.
backend/projects/Project_*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
!Test/dbc/mg100_demo.log
logs/
backend/logs/

# Reports / Exports
backend/reports/*.pdf
backend/reports/*.html
backend/reports/*.docx
backend/exports/*.csv

# OS
.DS_Store
Thumbs.db

# CodeBuddy (project-level agent data)
# Keep agent definitions but ignore team runtime data
.codebuddy/teams/

# WorkBuddy (project-level agent data & memory)
.workbuddy/

# Coverage
coverage/
.coverage
htmlcov/

# UI redesign working artifacts (process outputs of closed issues #20-#23;
# large binary brand assets & one-off generator scripts stay out of the repo)
docs/brand/
docs/_gen_*.py
docs/_icons_extract.json
docs/_tc_icon_cands.json
docs/ui-*.html
docs/flow-editor-ui-options.html
docs/tc-icon-picker.html
docs/UI_PAGE_LEVEL_AUDIT.md
docs/UI_REDESIGN_PLAN.md

# Packaging scratch space (git-archive docs copies, silent-install verification)
.build_tmp/
.build_tmp2/
backend/.trash_*
.commit_msg.txt


# Local bench captures: real vendor DBC matrices and CANoe ASC/BLF logs are
# intentionally kept out of this public repository. Only the synthetic
# mg100_demo fixtures are versioned so the DBC regression suites still run.
Test/dbc/*.dbc
Test/dbc/*.asc
Test/dbc/*.blf
!Test/dbc/mg100_demo.dbc

# Vendor PSU manuals: downloaded from brand websites and kept locally
# only (25 MB, redistribution unknown). Plugin runtime needs only the
# Markdown summaries under backend/plugins/manuals/.
/docs/dc_power/manuals/*.pdf

# Dedicated Chromium profile used by the standalone app window (run.py).
BrowserProfile/
